<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="16dp" android:background="@drawable/widget_surface_light">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Deep work" android:textSize="14sp" android:textStyle="bold" android:textColor="#192330" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Work" android:textSize="12sp" android:textColor="#596575" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="25:00" android:textSize="32sp" android:fontFamily="sans-serif-medium" android:textColor="#192330" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Focus ready" android:textSize="12sp" android:textColor="#596575" />
        <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="12dp" android:progress="0" android:progressTint="#5179C7" android:progressBackgroundTint="#B3C0D3" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/widget_ic_play" android:tint="#5179C7" android:contentDescription="Start session" />
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/widget_ic_refresh" android:tint="#5179C7" android:contentDescription="Refresh widget" />
        <TextView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/widget_ic_configure" android:tint="#5179C7" android:contentDescription="Configure widget" />
    </LinearLayout>
</LinearLayout>